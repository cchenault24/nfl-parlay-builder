# Local dev runs entirely on the Firebase emulator suite — there is no cloud
# project behind it. `demo-` project ids make the Firebase SDKs refuse to reach
# a real backend, so these values are deliberately fake and safe to commit.
#
# Keep local config in this one file: Vite ranks .env.development.local above
# .env.local, so a second file silently wins and is easy to miss.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-parlaid.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-parlaid
VITE_FIREBASE_STORAGE_BUCKET=demo-parlaid.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Backend secrets are pulled from the prod project by `npm run dev`
# (firebase functions:secrets:access) into functions/.secret.local.
