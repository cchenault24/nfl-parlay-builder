# Local app env (Vite) — Firebase web config for the project you run against
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend secrets live in Firebase Secret Manager (OPENAI_API_KEY, ODDS_API_KEY).
# `npm run dev` loads them for the Functions emulator via `firebase functions:secrets:access`.
