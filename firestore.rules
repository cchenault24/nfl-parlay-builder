rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Rate limit documents - CRITICAL: Only server-side access
    match /rate_limits/{document} {
      // Completely block client access to rate limit data
      // Only Cloud Functions with Admin SDK can read/write
      allow read, write: if false;
    }
    
    // User profiles - users can read/write their own profile.
    //
    // There is deliberately no second, broader read rule here. One existed for
    // "social features if needed" and granted every signed-in user read access
    // to any profile whose keys were a subset of displayName/photoURL/createdAt.
    // Nothing was exposed only because createUserProfile also writes `email`,
    // which failed the hasOnly check — so the day someone stopped writing that
    // field, every profile would have become world-readable to the signed-in
    // population, with no rules change and nothing to catch it. There are no
    // social features; add the rule when there are.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Parlay history
    match /parlays/{parlayId} {
      allow read, delete: if request.auth != null 
        && resource.data.userId == request.auth.uid;
      
      // No client `update`. Neither client calls updateDoc, and the rule that
      // used to grant it checked only `resource.data.userId` — the document
      // BEFORE the write — so a user could create their own parlay and then
      // update it to set `userId` to someone else's. It would pass, and the
      // attacker-authored document would then match the victim's history query
      // and render in their app with attacker-controlled selection and
      // reasoning text. The sweeps would grade it, and /parlays/:id/share would
      // mint a public link from it.
      //
      // If an edit feature ever needs this, the clause must constrain
      // `request.resource.data` (the document being written) as well, and must
      // pin `userId`, `createdAt` and the server-written `grading` field against
      // their existing values.
      
      // `gameIds`, not `gameId`: a parlay can span several games, and the
      // sweeps that grade it and price its close read the list. Documents saved
      // before cross-game parlays existed still carry the old single `gameId`
      // and are normalized on read — this rule governs writes only.
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'gameIds', 'legs', 'createdAt'])
        && request.resource.data.gameIds is list
        && request.resource.data.gameIds.size() > 0
        && request.resource.data.createdAt == request.time;
    }
    
    // Public copies of shared parlays. Written and read only through the
    // API, which strips the owner's uid before copying — clients never touch
    // this collection directly, so a link can never expose more than the
    // sanitized document the server built.
    match /sharedParlays/{shareId} {
      allow read, write: if false;
    }

    // User settings/preferences
    match /userSettings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Tier entitlements and generation quotas - CRITICAL: server-side only.
    // These deliberately do NOT live on users/{uid} or userSettings/{uid},
    // both of which the signed-in user can write: a tier or a used-count
    // stored there could be rewritten from a browser console, granting Pro
    // or clearing a spent quota. Clients read their tier from
    // GET /entitlements, which is served by the Admin SDK.
    match /entitlements/{userId} {
      allow read, write: if false;
    }
    match /quotas/{userId} {
      allow read, write: if false;
    }
    
    // Analytics or usage tracking (optional)
    match /analytics/{document} {
      // Only allow server-side writes for analytics
      allow read: if false;
      allow write: if false;
    }
    
    // System configuration (read-only for authenticated users)
    match /config/{document} {
      allow read: if request.auth != null;
      allow write: if false; // Only admin/server can write
    }
    
    // Feedback/support tickets
    match /feedback/{feedbackId} {
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null 
        && resource.data.userId == request.auth.uid;
      allow update: if false; // Prevent updates after submission
    }
    
    // Default deny rule - IMPORTANT for security
    match /{document=**} {
      allow read, write: if false;
    }
  }
}