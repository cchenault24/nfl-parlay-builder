{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "lib",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  // Tests and their fixtures are typechecked by `npm test` (vitest runs them
  // through esbuild) but never compiled into lib/ — Firebase packages that
  // directory verbatim and nothing there should ship.
  "exclude": ["src/**/*.test.ts", "src/testing/**"]
}
