# Copy to .env.local and fill in from the Firebase console.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional. iOS OAuth client ID from Google Cloud, for the same project.
# Until this is set, the Google button is hidden and email/password is the
# only sign-in method.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Absolute base URL for the Cloud Functions API. Mobile has no
# same-origin /api rewrite, so this must be a full URL.
# Deployed:       https://<project-id>.web.app/api
# Local emulator: http://localhost:5001/<project-id>/us-central1/api
EXPO_PUBLIC_API_BASE_URL=
