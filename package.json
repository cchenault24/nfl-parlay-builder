{
  "name": "nfl-parlay-builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node start-dev.js",
    "dev:functions": "firebase emulators:start --only functions",
    "dev:frontend": "vite --host",
    "kill:all": "node scripts/kill-all.js",
    "build": "tsc && vite build",
    "lint": "eslint src shared --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src shared --ext .ts,.tsx --fix --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"{src,shared}/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"{src,shared}/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "build:all": "npm run build && npm run build:functions",
    "build:functions": "cd functions && npm run build",
    "lint:all": "npm run lint:fix && npm run lint:functions",
    "lint:functions": "cd functions && npm run lint",
    "format:all": "npm run format && npm run format:functions",
    "format:functions": "cd functions && npm run format",
    "prepare:all": "npm run lint:all && npm run format:all && npm run build:all"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.10",
    "@mui/material": "^5.15.10",
    "@tanstack/react-query": "^5.20.1",
    "axios": "^1.6.7",
    "firebase": "^12.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-firebase-hooks": "^5.1.1",
    "react-router-dom": "^7.18.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5",
    "eslint-plugin-react-refresh": "^0.4.5",
    "globals": "^16.4.0",
    "jiti": "^2.5.1",
    "prettier": "^3.6.2",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^5.1.0",
    "wait-on": "^9.0.1"
  }
}
